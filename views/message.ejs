<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Message</title>
    <link rel="stylesheet" href="/appStyles.css">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="app">
        <div class="header">
            <h1>Message Board</h1>
        </div>
            <div class="message">
                <p>ID: <span><%= message.id %> </span></p>
                <p>User: <%= message.user %></p>
                <p>Text: <%= message.text %></p>
                <p>Created on: <%= message.added.toLocaleString() %> </p>
                 <a class="card-link" href="/">Go Back</a>
            </div>   
        <%- include ('footer') %>
    </div>
</body>
</html>